// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Gender {
  MASCULINO
  FEMENINO
  OTRO
}

enum PersonType {
  NATURAL
  JURIDICA
}

enum IdentityType {
  CEDULA
  RUC
  PASAPORTE
}

enum LoyaltyTransactionType {
  EARNED // Ganó puntos por compra
  REDEEMED // Canjeó puntos
  EXPIRED // Puntos expirados
  ADJUSTED // Ajuste manual
}

enum RewardType {
  PRODUCT // Producto físico del inventario
  DISCOUNT_PERCENTAGE // Descuento en porcentaje (ej: 20%)
  DISCOUNT_FIXED // Descuento fijo (ej: $5)
  COUPON // Cupón especial
}

enum TaxDefaultGroup {
  IVA
  ICE
  IRBPNR
}

// ==================== MODELS ====================

model People {
  id             String       @id @default(cuid())
  firstName      String       @map("first_name") @db.VarChar(60)
  lastName       String?      @map("last_name") @db.VarChar(60)
  rucCi          String       @unique @map("ruc_ci") @db.VarChar(13)
  birthDate      DateTime?    @map("birth_date") @db.Date
  mainEmail      String?      @unique @map("main_email") @db.VarChar(100)
  phone          String?      @db.VarChar(30)
  address        String?      @db.VarChar(255)
  personType     PersonType   @map("person_type")
  identityType   IdentityType @map("identity_type")
  dateRegistered DateTime     @default(now()) @map("date_registered")

  // Relaciones
  user     User?
  customer Customer?

  @@map("peoples")
}

model User {
  id             String   @id @default(cuid())
  firstName      String   @map("first_name") @db.VarChar(60)
  lastName       String   @map("last_name") @db.VarChar(60)
  email          String   @unique @db.VarChar(100)
  confirmedEmail Boolean  @default(false) @map("confirmed_email")
  phoneNumber    String?  @map("phone_number") @db.VarChar(30)
  gender         Gender
  dateOfBirth    DateTime @map("date_of_birth") @db.Date
  codUser        String?  @unique @map("cod_user") @db.VarChar(9)
  address        String?  @db.VarChar(255)
  alias          String   @db.VarChar(50)
  urlImage       String?  @map("url_image") @db.VarChar(500)
  active         Boolean  @default(true)
  password       String   @db.VarChar(255)
  refreshToken   String?  @map("refresh_token") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relación uno a uno con People (nullable)
  peopleId String? @unique @map("people_id")
  people   People? @relation(fields: [peopleId], references: [id])

  // Relaciones
  sales Sale[]

  @@map("users")
}

// ==================== CUSTOMER & LOYALTY ====================

model Customer {
  id String @id @default(cuid())

  // Relación 1:1 con People
  peopleId String @unique @map("people_id")
  people   People @relation(fields: [peopleId], references: [id])

  // Relación con categoría
  customerCategoryId String           @map("customer_category_id")
  customerCategory   CustomerCategory @relation(fields: [customerCategoryId], references: [id])

  // Información comercial
  totalPurchases         Decimal   @default(0) @map("total_purchases") @db.Decimal(10, 2)
  lastPurchaseDate       DateTime? @map("last_purchase_date")
  loyaltyPoints          Int       @default(0) @map("loyalty_points")
  preferredPaymentMethod String?   @map("preferred_payment_method") @db.VarChar(50)
  active                 Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  loyaltyTransactions LoyaltyTransaction[]
  sales               Sale[]

  @@map("customers")
}

model CustomerCategory {
  id                 String  @id @default(cuid())
  name               String  @unique @db.VarChar(100)
  discountPercentage Decimal @default(0) @map("discount_percentage") @db.Decimal(5, 2) // 0-100
  pointsMultiplier   Decimal @default(1) @map("points_multiplier") @db.Decimal(3, 2) // ej: 1.5x
  ticketThreshold    Decimal @map("ticket_threshold") @db.Decimal(10, 2) // Valor mínimo para generar 1 ticket
  color              String? @db.VarChar(7) // Color hex: #FF0000
  active             Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  customers Customer[]

  @@map("customer_categories")
}

model LoyaltyTransaction {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])

  points      Int // Positivo o negativo
  type        LoyaltyTransactionType
  description String                 @db.VarChar(255)

  // Referencias opcionales
  orderId  String? @map("order_id") // Para implementar después
  rewardId String? @map("reward_id")
  reward   Reward? @relation(fields: [rewardId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("loyalty_transactions")
}

model Reward {
  id          String     @id @default(cuid())
  name        String     @db.VarChar(150)
  description String?    @db.Text
  rewardType  RewardType @map("reward_type")

  // Costos en puntos
  pointsCost Int @map("points_cost")

  // Para rewards tipo PRODUCT
  presentationId String?       @map("presentation_id")
  presentation   Presentation? @relation("PresentationRewards", fields: [presentationId], references: [id])
  stock          Int           @default(0) // Stock de rewards (no afecta inventario real)

  // Para rewards tipo DISCOUNT
  discountValue Decimal? @map("discount_value") @db.Decimal(10, 2) // 20 para 20% o $20

  // Validez
  validFrom  DateTime? @map("valid_from")
  validUntil DateTime? @map("valid_until")

  // Otros
  imageUrl String? @map("image_url") @db.VarChar(500)
  active   Boolean @default(true)
  terms    String? @db.Text // Términos y condiciones

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  loyaltyTransactions LoyaltyTransaction[]

  @@map("rewards")
}

// ==================== PRODUCTS ====================

model Category {
  id           String  @id @default(cuid())
  name         String  @unique @db.VarChar(60)
  icon         String? @db.VarChar(50) // Emoji o nombre de icono
  color        String? @db.VarChar(7) // Color hex
  displayOrder Int     @default(0) @map("display_order")
  active       Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  products Product[]

  @@map("categories")
}

// ==================== PRODUCTS CATEGORY ====================

model Product {
  id         String   @id @default(cuid())
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  name             String  @db.VarChar(60)
  slug             String  @unique @db.VarChar(150)
  shortDescription String? @map("short_description") @db.VarChar(20)
  active           Boolean @default(true)
  featured         Boolean @default(false) // Producto destacado

  // Presentaciones por defecto
  defaultPurchasePresentationId String? @map("default_purchase_presentation_id")
  defaultSalePresentationId     String? @map("default_sale_presentation_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  images        ProductImage[]
  presentations Presentation[] @relation("ProductPresentations")
  productTaxes  ProductTax[]
  productStock  ProductStock?

  // Relaciones con presentaciones por defecto
  defaultPurchasePresentation Presentation? @relation("DefaultPurchasePresentation", fields: [defaultPurchasePresentationId], references: [id], onDelete: SetNull)
  defaultSalePresentation     Presentation? @relation("DefaultSalePresentation", fields: [defaultSalePresentationId], references: [id], onDelete: SetNull)

  @@unique([name])
  @@index([categoryId])
  @@index([defaultPurchasePresentationId])
  @@index([defaultSalePresentationId])
  @@map("products")
}

// ==================== PRODUCTS IMAGE ===================

model ProductImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  imageUrl     String  @map("image_url") @db.VarChar(500)
  altText      String? @map("alt_text") @db.VarChar(255)
  isPrimary    Boolean @default(false) @map("is_primary") // Imagen principal
  displayOrder Int     @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_images")
}

model PresentationType {
  id   String @id @default(cuid())
  name String @unique @db.VarChar(35) // "Unidad", "Docena", "Bulto", etc

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  presentations Presentation[]
  stockConfigurations ProductStock[]

  @@map("presentation_types")
}


model Presentation {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation("ProductPresentations", fields: [productId], references: [id], onDelete: Cascade)

  presentationTypeId String           @map("presentation_type_id")
  presentationType   PresentationType @relation(fields: [presentationTypeId], references: [id])

  // Referencia a la presentación base/componente de este producto
  presentationInferenceId String?       @map("presentation_inference")
  presentationInference   Presentation? @relation("PresentationInference", fields: [presentationInferenceId], references: [id], onDelete: Restrict)
  inferredPresentations   Presentation[] @relation("PresentationInference")

  // Cantidad real en unidades base del producto (uso interno para cálculos y orden)
  baseUnitsQuantity Int @default(1) @map("base_units_quantity")

  quantity Int // Cantidad de la presentación de referencia (ej: balde = 12 unidades)
  barcode  String? @db.VarChar(50) // Nullable porque no todos los productos tienen código de barras

  @@unique([barcode]) // Solo si tiene valor debe ser único

  // Precios
  costPrice        Decimal  @map("cost_price") @db.Decimal(10, 2)
  lastCostPrice    Decimal? @map("last_cost_price") @db.Decimal(10, 2) // Última compra
  averageCostPrice Decimal? @map("average_cost_price") @db.Decimal(10, 2) // Costo promedio
  salePrice        Decimal  @map("sale_price") @db.Decimal(10, 2)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  rewards                        Reward[]         @relation("PresentationRewards")
  defaultForPurchaseInProducts   Product[]        @relation("DefaultPurchasePresentation")
  defaultForSaleInProducts       Product[]        @relation("DefaultSalePresentation")
  saleDetails                    SaleDetail[]
  saleProductTaxes               SaleProductTax[]

  @@unique([productId, presentationTypeId])
  @@index([productId])
  @@index([presentationTypeId])
  @@index([presentationInferenceId])
  @@index([productId, active])
  @@map("presentations")
}

// Stock unificado por producto (base de descuento en ventas)
model ProductStock {
  id       String  @id @default(cuid())
  productId String @unique @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Presentación en la que se visualiza el stock
  stockPresentationTypeId String           @map("stock_presentation_type_id")
  stockPresentationType   PresentationType @relation(fields: [stockPresentationTypeId], references: [id])

  // Stock real en unidades base del producto
  stock    Int  @default(0)
  minStock Int  @default(0) @map("min_stock")
  maxStock Int? @map("max_stock")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("product_stocks")
}

// ==================== PAYMENT METHODS ====================

model PaymentMethod {
  id   String  @id @default(cuid())
  name String  @unique @db.VarChar(100) // "Efectivo", "Tarjeta", "Pichincha", "Transferencia"
  code String  @unique @db.VarChar(50) // "CASH", "CARD", "PICHINCHA", "TRANSFER"
  icon String? @db.VarChar(50)

  // Configuración
  requiresReference Boolean @default(false) @map("requires_reference") // Si requiere número de referencia
  allowsChange      Boolean @default(false) @map("allows_change") // Si permite dar cambio

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payment_methods")
}

// ==================== TAXES (Estructura SRI Ecuador) ====================

// Tabla principal de impuestos (IVA, ICE, IRBPNR, etc.)
model Tax {
  id          String  @id @default(cuid())
  code        Int     @unique @default(autoincrement()) // Código numérico del impuesto
  description String  @map("description") @db.VarChar(255) // Descripción del impuesto
  active      Boolean @default(true) @map("active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  taxValues TaxValue[]

  @@map("taxes")
}

// Valores/tasas específicas de cada impuesto con vigencia
model TaxValue {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(255) // Código del valor (ej: "2", "3", "5")
  taxId       String   @map("tax_id")
  tax         Tax      @relation(fields: [taxId], references: [id], onDelete: Cascade)
  
  percentage          Decimal @db.Decimal(18, 2) // Porcentaje del impuesto
  retentionPercentage Decimal? @map("retention_percentage") @db.Decimal(18, 3) // Porcentaje de retención
  taxType             String  @map("tax_type") @db.VarChar(1) // Tipo de impuesto
  description         String  @db.VarChar(600) // Descripción del valor
  
  // Vigencia
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  
  // Configuración adicional
  adminCode              Int     @map("admin_code") // Código administrativo
  freePercentageMark     String  @map("free_percentage_mark") @db.VarChar(1) // Marca de porcentaje libre
  calculateWithQuantity  String? @map("calculate_with_quantity") @db.Text // Si calcula con cantidad
  
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  productTaxes     ProductTax[]
  productDefaults  ProductTaxDefault[]

  @@map("tax_values")
}

// Configuración de impuestos por defecto para nuevos productos
model ProductTaxDefault {
  id String @id @default(cuid())

  taxGroup     TaxDefaultGroup @map("tax_group")
  taxValueCode String          @map("tax_value_code") @db.VarChar(255)
  taxValue     TaxValue        @relation(fields: [taxValueCode], references: [code], onDelete: Restrict)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([taxGroup])
  @@map("product_tax_defaults")
}

// Vinculación de productos con tasas de impuestos
model ProductTax {
  id           String   @id @default(cuid())
  productId    String   @map("product_id")
  taxValueCode String   @map("tax_value_code") @db.VarChar(255) // Código del valor de impuesto
  
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  taxValue TaxValue @relation(fields: [taxValueCode], references: [code], onDelete: Cascade)

  // Permite override del porcentaje para este producto específico
  appliedRate      Decimal  @default(0) @map("applied_rate") @db.Decimal(5, 4)
  isDefaultVat     Boolean  @default(false) @map("is_default_vat") // Si es el IVA por defecto
  active           Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, taxValueCode])
  @@index([productId])
  @@index([productId, active])
  @@map("product_taxes")
}

// ==================== SALES & BILLING ====================

enum PaymentMethodType {
  CASH // Efectivo
  TRANSFER // Transferencia bancaria
  CARD // Tarjeta de débito/crédito
  CREDIT // Venta a crédito
}

enum CardType {
  VISA
  MASTERCARD
  AMERICAN_EXPRESS
  DINERS_CLUB
  DISCOVER
  OTHER
}

enum SaleStatus {
  PENDING // En proceso
  COMPLETED // Completada y pagada
  CANCELLED // Cancelada/anulada
  CREDIT // A crédito (pendiente de pago)
  PARTIAL_PAYMENT // Crédito con pago parcial
}

// Catálogo de bancos para transferencias
model Bank {
  id   String  @id @default(cuid())
  code String  @unique @db.VarChar(10) // Código del banco (ej: "001", "002")
  name String  @db.VarChar(150)
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  salePayments SalePayment[]
  creditPayments CreditPayment[]

  @@map("banks")
}

// Control de secuenciales de factura (formato SRI: establecimiento-punto-secuencial)
model InvoiceSequence {
  id             String @id @default(cuid())
  establishment  String @db.VarChar(3) // "001", "002", etc.
  pointOfSale    String @map("point_of_sale") @db.VarChar(3) // "001", "002", etc.
  lastSequential Int    @default(0) @map("last_sequential") // Último número usado
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([establishment, pointOfSale])
  @@map("invoice_sequences")
}

// Venta/Factura principal
model Sale {
  id            String     @id @default(cuid())
  invoiceNumber String     @unique @map("invoice_number") @db.VarChar(17) // 001-001-000000001
  
  // Cliente
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])

  // Usuario que registra la venta
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  // Montos
  subtotal     Decimal @db.Decimal(10, 2) // Subtotal sin impuestos
  taxAmount    Decimal @map("tax_amount") @db.Decimal(10, 2) // Total de impuestos
  total        Decimal @db.Decimal(10, 2) // Total a pagar
  discount     Decimal @default(0) @db.Decimal(10, 2) // Descuentos aplicados
  
  // Estado y fechas
  status    SaleStatus
  saleDate  DateTime   @default(now()) @map("sale_date")
  
  // Notas
  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  details        SaleDetail[]
  payments       SalePayment[]
  productTaxes   SaleProductTax[]
  credit         Credit?

  @@map("sales")
}

// Detalle de productos en la venta
model SaleDetail {
  id     String @id @default(cuid())
  saleId String @map("sale_id")
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  // Producto y presentación
  presentationId String       @map("presentation_id")
  presentation   Presentation @relation(fields: [presentationId], references: [id])

  // Snapshot de datos en el momento de la venta
  productName      String  @map("product_name") @db.VarChar(100)
  presentationName String  @map("presentation_name") @db.VarChar(100)
  
  // Cantidades y precios
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2) // Precio unitario al momento de la venta
  subtotal  Decimal @db.Decimal(10, 2) // quantity * unitPrice

  createdAt DateTime @default(now()) @map("created_at")

  @@map("sale_details")
}

// Impuestos calculados por producto en la venta
model SaleProductTax {
  id     String @id @default(cuid())
  saleId String @map("sale_id")
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  presentationId String       @map("presentation_id")
  presentation   Presentation @relation(fields: [presentationId], references: [id])

  // Snapshot del impuesto aplicado
  taxCode        String  @map("tax_code") @db.VarChar(10) // Código del impuesto
  taxDescription String  @map("tax_description") @db.VarChar(255)
  taxPercentage  Decimal @map("tax_percentage") @db.Decimal(5, 2) // Porcentaje aplicado
  taxableAmount  Decimal @map("taxable_amount") @db.Decimal(10, 2) // Base imponible
  taxAmount      Decimal @map("tax_amount") @db.Decimal(10, 2) // Monto del impuesto

  createdAt DateTime @default(now()) @map("created_at")

  @@map("sale_product_taxes")
}

// Métodos de pago aplicados a una venta (puede ser múltiple para pagos mixtos)
model SalePayment {
  id     String @id @default(cuid())
  saleId String @map("sale_id")
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  paymentType PaymentMethodType @map("payment_type")
  amount      Decimal           @db.Decimal(10, 2)

  // CASH - Efectivo
  cashReceived Decimal? @map("cash_received") @db.Decimal(10, 2) // Monto recibido
  change       Decimal? @db.Decimal(10, 2) // Vuelto

  // TRANSFER - Transferencia
  bankId            String? @map("bank_id")
  bank              Bank?   @relation(fields: [bankId], references: [id])
  bankAccount       String? @map("bank_account") @db.VarChar(50)
  transferReference String? @map("transfer_reference") @db.VarChar(100)

  // CARD - Tarjeta
  cardType      CardType? @map("card_type")
  voucherNumber String?   @map("voucher_number") @db.VarChar(100)

  // Notas adicionales
  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@map("sale_payments")
}

// Registro de créditos (cuentas por cobrar)
model Credit {
  id     String @id @default(cuid())
  saleId String @unique @map("sale_id")
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  // Montos
  totalAmount Decimal @map("total_amount") @db.Decimal(10, 2) // Monto total del crédito
  paidAmount  Decimal @default(0) @map("paid_amount") @db.Decimal(10, 2) // Monto pagado
  balance     Decimal @db.Decimal(10, 2) // Saldo pendiente

  // Fechas
  dueDate DateTime? @map("due_date") // Fecha de vencimiento (opcional)
  paidDate DateTime? @map("paid_date") // Fecha de pago completo

  // Estado
  isPaid Boolean @default(false) @map("is_paid")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  payments CreditPayment[]

  @@map("credits")
}

// Abonos a créditos
model CreditPayment {
  id       String @id @default(cuid())
  creditId String @map("credit_id")
  credit   Credit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  amount        Decimal           @db.Decimal(10, 2)
  paymentType   PaymentMethodType @map("payment_type")
  paymentDate   DateTime          @default(now()) @map("payment_date")

  // Documentos de pago (igual que SalePayment)
  bankId            String?   @map("bank_id")
  bank              Bank?     @relation(fields: [bankId], references: [id])
  bankAccount       String?   @map("bank_account") @db.VarChar(50)
  transferReference String?   @map("transfer_reference") @db.VarChar(100)
  cardType          CardType? @map("card_type")
  voucherNumber     String?   @map("voucher_number") @db.VarChar(100)

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@map("credit_payments")
}
